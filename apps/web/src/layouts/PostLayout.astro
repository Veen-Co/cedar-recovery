---
import Layout from './Layout.astro'
import PostHeader from '../components/blocks/PostHeader.astro'
import PostSidebar from '../components/blocks/PostSidebar.astro'
import { resolveMediaUrl } from '../lib/payload'
import type { Post } from 'types'

interface Props {
  post: Post
}

const { post } = Astro.props
const metaImage = resolveMediaUrl(typeof post.meta?.image === 'object' ? post.meta.image?.url : undefined)
---

<Layout
	title={post.meta?.title || post.title}
	description={post.meta?.description || post.summary}
	image={metaImage}
>
	<main
		class="mx-auto grid max-w-(--container-content) grid-cols-1 gap-12 px-6 py-12 md:grid-cols-[1fr_18rem]"
	>
		<article class="flex flex-col gap-10">
			<PostHeader post={post} />
			<slot />
		</article>
		<PostSidebar post={post} />
	</main>
</Layout>
