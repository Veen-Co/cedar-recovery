---
import Layout from './Layout.astro'
import Hero from '../components/blocks/Hero.astro'
import SidebarBlockRenderer from '../components/blocks/SidebarBlockRenderer.astro'
import { resolveMediaUrl } from '../lib/payload'
import type { Post } from 'types'

interface Props {
  post: Post
}

const { post } = Astro.props
const metaImage = resolveMediaUrl(typeof post.meta?.image === 'object' ? post.meta.image?.url : undefined)
---

<Layout
	title={post.meta?.title || post.title}
	description={post.meta?.description || post.summary}
	image={metaImage}
>
	<Hero hero={post.hero} title={post.title} />
	<main
		class="mx-auto grid max-w-(--container-content) grid-cols-1 gap-12 px-6 py-12 md:grid-cols-[1fr_18rem]"
	>
		<article>
			<slot />
		</article>
		{
			post.sidebar && post.sidebar.length > 0 && (
				<aside class="space-y-6">
					<SidebarBlockRenderer blocks={post.sidebar} />
				</aside>
			)
		}
	</main>
</Layout>
