---
interface Props {
  href: string
  variant?: 'primary' | 'secondary' | 'accent'
  class?: string
}

const { href, variant = 'primary', class: className } = Astro.props

// Each variant owns its full class string rather than a shared base +
// override — `accent`'s padding/radius/size genuinely differ from the
// other two, and overriding one Tailwind utility with another via a
// passed-in class isn't reliably safe.
const variantClasses = {
  primary:
    'inline-flex items-center rounded-md px-4 py-2 text-sm font-medium bg-primary text-primary-foreground transition hover:opacity-90',
  secondary:
    'inline-flex items-center rounded-md px-4 py-2 text-sm font-medium border border-border text-foreground transition hover:bg-border/20',
  // Matches the filter-pill visual language (PostGrid.astro) — used for
  // the post header's "Download Resource" CTA.
  accent:
    'inline-flex items-center rounded border border-orange-400 bg-accent-subtle px-[10px] py-[10px] text-base tracking-[-0.24px] text-slate-900 transition hover:bg-orange-300',
}[variant]
---

<a href={href} class:list={[variantClasses, className]}>
	<slot />
</a>
