---
import Container from '../primitives/Container.astro'

interface Props {
  heading?: string | null
  items?: { question: string; answer: string }[] | null
}

const { heading, items } = Astro.props
---

<section class="py-16">
	<Container class="max-w-3xl">
		{heading && <h2 class="text-center text-2xl font-semibold">{heading}</h2>}
		<div class:list={['divide-y divide-border', heading && 'mt-10']}>
			{
				items?.map((item) => (
					<details class="py-4">
						<summary class="cursor-pointer list-none font-medium">{item.question}</summary>
						<p class="mt-2 text-muted">{item.answer}</p>
					</details>
				))
			}
		</div>
	</Container>
</section>
