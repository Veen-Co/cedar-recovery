---
import Container from '../primitives/Container.astro'

interface Props {
  heading?: string | null
  features?: { title: string; description?: string | null }[] | null
}

const { heading, features } = Astro.props
---

<section class="py-16">
	<Container>
		{heading && <h2 class="text-center text-2xl font-semibold">{heading}</h2>}
		<div class:list={['grid gap-8 sm:grid-cols-2 lg:grid-cols-3', heading && 'mt-10']}>
			{
				features?.map((feature) => (
					<div>
						<h3 class="font-medium">{feature.title}</h3>
						{feature.description && <p class="mt-2 text-muted">{feature.description}</p>}
					</div>
				))
			}
		</div>
	</Container>
</section>
