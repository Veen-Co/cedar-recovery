---
// Post-only — pulls straight from the post's own fields (title,
// publishedDate, summary, externalLink), not the shared Hero
// component/hero-fields group. PostLayout.astro no longer renders <Hero>
// for posts at all; the Hero tab still exists on Posts in the admin but
// is currently unused on the frontend here.
import Button from '../primitives/Button.astro'
import type { Post } from 'types'

interface Props {
  post: Post
}

const { post } = Astro.props

const publishedDate = post.publishedDate
  ? new Date(post.publishedDate).toLocaleDateString('en-US')
  : null

const externalUrl = post.externalLink?.url
// "Download Resource" (not "Read more") — matches the design's copy, and
// fits the actual use case (linking out to a PDF) better than a generic
// fallback.
const externalLabel = post.externalLink?.label || 'Download Resource'
---

<div class="flex flex-col items-start gap-6">
	{publishedDate && <p class="text-base tracking-[-0.24px] text-accent">Published : {publishedDate}</p>}
	<h1 class="font-serif text-[48px] leading-[1.1] tracking-[-1.92px] text-foreground">{post.title}</h1>
	<p class="font-serif text-[32px] leading-[1.1] tracking-[-0.64px] text-foreground">{post.summary}</p>
	{externalUrl && (
		<Button href={externalUrl} variant="accent">
			{externalLabel}
		</Button>
	)}
</div>
