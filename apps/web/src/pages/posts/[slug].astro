---
import PostLayout from '../../layouts/PostLayout.astro'
import Prose from '../../components/primitives/Prose.astro'
import { lexicalToHtml } from '../../lib/lexicalToHtml'
import { getPosts } from '../../lib/payload'
import type { Post } from 'types'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

interface Props {
  post: Post
}

const { post } = Astro.props
const bodyHtml = post.body ? lexicalToHtml(post.body) : null
---

<PostLayout post={post}>
	{/* PostHeader (in PostLayout) already renders summary + externalLink CTA */}
	<a class="text-sm text-muted" href="/posts">&larr; All posts</a>
	{bodyHtml && <Prose class="mt-4" set:html={bodyHtml} />}
</PostLayout>
