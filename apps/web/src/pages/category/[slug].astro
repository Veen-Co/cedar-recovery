---
import Layout from '../../layouts/Layout.astro'
import { getCategories, getPosts } from '../../lib/payload'
import type { Category, Post } from 'types'

export async function getStaticPaths() {
  const categories = await getCategories()
  return Promise.all(
    categories.map(async (category) => ({
      params: { slug: category.slug },
      props: { category, posts: await getPosts({ categoryId: category.id }) },
    })),
  )
}

interface Props {
  category: Category
  posts: Post[]
}

const { category, posts } = Astro.props
---

<Layout title={category.name} description={category.description ?? undefined}>
	<main class="mx-auto max-w-(--container-content) px-6 py-12">
		<a class="text-sm text-muted" href="/">&larr; All posts</a>
		<h1 class="mt-4 text-3xl font-semibold">{category.name}</h1>
		{category.description && <p class="mt-2 text-muted">{category.description}</p>}

		<ul class="mt-8 space-y-8">
			{
				posts.map((post) => (
					<li class="border-b border-border pb-8">
						<a class="text-lg font-medium" href={`/posts/${post.slug}`}>
							{post.title}
						</a>
						<p class="mt-2 text-muted">{post.summary}</p>
					</li>
				))
			}
		</ul>
	</main>
</Layout>
