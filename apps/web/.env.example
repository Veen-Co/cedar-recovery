PAYLOAD_URL=http://localhost:3000

# Used only for the sitemap's absolute URLs (astro.config.mjs). Note this
# one doesn't actually work from a .env file — Astro evaluates its config
# before loading .env, so this needs to be a real shell/CI env var (e.g.
# `SITE_URL=https://x.com pnpm build`). Vercel sets env vars this way
# directly anyway, so that's not a gap for the deployment target that
# matters. A sitemap pointing at the wrong domain is worse than none.
SITE_URL=
EXAMPLE_URL=
