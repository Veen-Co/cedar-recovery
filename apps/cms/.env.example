DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Neon Object Storage (S3-compatible) — see `neon buckets list` for the
# bucket name (it's not one of these env vars, it's a literal in
# payload.config.ts's s3Storage() call).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Resend email adapter — used for Payload's auth emails (password reset, etc).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Cedar Recovery

# Optional. A Vercel Deploy Hook URL for apps/web — when set, publishing or
# deleting content triggers a rebuild of the static site. Leave unset for
# local dev (hooks/triggerDeploy.ts silently no-ops without it).
DEPLOY_HOOK_URL=
